# Copy to .env on your SERVER and fill in. Never commit .env to GitHub.
# Server
PORT=3000
APP_URL=http://127.0.0.1:3000
ADMIN_PASSWORD=change-me-strong-password

# OpenAI-compatible upstream for live model replies (optional - demo mode works without)
# OPENCODE_API_BASE=https://your-provider.example/api
# OPENCODE_API_KEY=

# GitHub OAuth (optional - create OAuth App on GitHub)
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
